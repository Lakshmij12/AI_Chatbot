# EXAMPLE secrets file.
#
# For LOCAL use: copy this file to ".streamlit/secrets.toml" and fill in your
# values. That real file is git-ignored, so your key never goes to GitHub.
#
# For STREAMLIT CLOUD: don't upload this file — instead paste these same lines
# into the app's "Secrets" box in the Streamlit Cloud settings (see DEPLOY.md).

ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# Optional: set a password so only people you share it with can use your
# deployed app (protects your API credits). Remove it to keep the app open.
# APP_PASSWORD = "choose-a-password"
